// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= Core User & Family Models =============

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  phone                 String?
  passwordHash          String
  displayName           String
  avatarUrl             String?
  bio                   String?
  birthday              DateTime?
  authProvider          String   @default("email")
  favoriteSongs         String[]
  photoStreak           Int      @default(0)
  longestStreak         Int      @default(0)
  aura                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  familyMembers         FamilyMember[]
  postsAuthored         Post[]
  postComments          Comment[]
  postReactions         Reaction[]
  storiesAuthored       Story[]
  dailyUploads          DailyUpload[]
  eventsCreated         Event[]
  eventRsvps            EventRsvp[]
  playlists             Playlist[]
  gameSessions          GameSession[]
  bucketListItems       BucketListItem[]
  timeCapsuleCreated    TimeCapsule[]
  achievements          Achievement[]
  notifications         Notification[]
  assistantMessages     AssistantMessage[]
  memberLocations       MemberLocation[]
  mailboxSent           MailboxLetter[] @relation("MailboxLetterSender")
  mailboxReceived       MailboxLetter[] @relation("MailboxLetterRecipient")
  wallEntries           WallEntry[]
  voiceNotes            VoiceNote[]
  gameWins             GameSession[] @relation("GameSessionWinner")
}

model Family {
  id                    String   @id @default(cuid())
  name                  String
  newspaperName         String?
  inviteCode            String   @unique
  avatarUrl             String?
  timezone              String   @default("UTC")
  familyStreak          Int      @default(0)
  createdBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  members               FamilyMember[]
  posts                 Post[]
  stories               Story[]
  dailyChallenges       DailyChallenge[]
  memories              Memory[]
  events                Event[]
  newspapers            Newspaper[]
  playlists             Playlist[]
  gameSessions          GameSession[]
  bucketListItems       BucketListItem[]
  timeCapsules          TimeCapsule[]
  achievements          Achievement[]
  photoSpots            PhotoSpot[]
  notifications         Notification[]
  assistantMessages     AssistantMessage[]
  memberLocations       MemberLocation[]
  mailboxLetters        MailboxLetter[]
  wallEntries           WallEntry[]
  voiceNotes            VoiceNote[]
  podcastEpisodes       PodcastEpisode[]
}

model FamilyMember {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  role                  String   @default("member")
  nickname              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

// ============= Posts & Media Models =============

model Post {
  id                    String   @id @default(cuid())
  familyId              String
  authorId              String
  caption               String?
  mediaUrls             String[]
  mediaType             String?
  albumId               String?
  aiTags                String[]
  location              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author                User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments              Comment[]
  reactions             Reaction[]
  memoriesIncluded      Memory[]
}

model Comment {
  id                    String   @id @default(cuid())
  postId                String
  userId                String
  content               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  post                  Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reaction {
  id                    String   @id @default(cuid())
  postId                String
  userId                String
  emoji                 String
  createdAt             DateTime @default(now())

  // Relations
  post                  Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
}

model Story {
  id                    String   @id @default(cuid())
  familyId              String
  authorId              String
  mediaUrl              String
  mediaType             String
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author                User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ============= Challenges & Daily Models =============

model DailyChallenge {
  id                    String   @id @default(cuid())
  familyId              String
  challengeDate         DateTime
  prompts               Json[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploads               DailyUpload[]
}

model DailyUpload {
  id                    String   @id @default(cuid())
  challengeId           String
  userId                String
  mediaUrl              String
  promptLabel           String?
  createdAt             DateTime @default(now())

  // Relations
  challenge             DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============= Memories & Collections =============

model Memory {
  id                    String   @id @default(cuid())
  familyId              String
  title                 String
  description           String?
  category              String?
  coverUrl              String?
  postIds               String[]
  dates                 DateTime[]
  locationName          String?
  aiSummary             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  posts                 Post[]
}

// ============= Events =============

model Event {
  id                    String   @id @default(cuid())
  familyId              String
  createdBy             String
  title                 String
  description           String?
  eventType             String
  startTime             DateTime
  endTime               DateTime?
  location              String?
  reminderMinutes       Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator               User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  rsvps                 EventRsvp[]
}

model EventRsvp {
  id                    String   @id @default(cuid())
  eventId               String
  userId                String
  status                String   @default("pending") // pending, accepted, declined
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ============= Newspaper & Podcast =============

model Newspaper {
  id                    String   @id @default(cuid())
  familyId              String
  sections              Json[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model PodcastEpisode {
  id                    String   @id @default(cuid())
  familyId              String
  title                 String
  description           String?
  audioUrl              String
  duration              Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// ============= Playlists & Games =============

model Playlist {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  name                  String
  songs                 Json[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameSession {
  id                    String   @id @default(cuid())
  familyId              String
  winnerId              String?
  gameType              String
  status                String   @default("active") // active, completed, abandoned
  players               Json[]
  score                 Json?
  startTime             DateTime @default(now())
  endTime               DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  winner                User?    @relation("GameSessionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
}

// ============= Bucket List & Time Capsules =============

model BucketListItem {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  title                 String
  description           String?
  category              String?
  priority              String   @default("medium")
  completed             Boolean  @default(false)
  assignedToIds         String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeCapsule {
  id                    String   @id @default(cuid())
  familyId              String
  createdBy             String
  title                 String
  contents              Json[]
  openDate              DateTime
  status                String   @default("sealed") // sealed, opened
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator               User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

// ============= Achievements & Notifications =============

model Achievement {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  achievementType       String
  earnedAt              DateTime @default(now())
  metadata              Json?
  createdAt             DateTime @default(now())

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                    String   @id @default(cuid())
  userId                String
  familyId              String?
  type                  String
  message               String
  read                  Boolean  @default(false)
  relatedId             String?
  createdAt             DateTime @default(now())

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family                Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
}

// ============= Locations & Mailbox =============

model PhotoSpot {
  id                    String   @id @default(cuid())
  familyId              String
  name                  String
  latitude              Float
  longitude             Float
  photoCount            Int      @default(0)
  createdAt             DateTime @default(now())

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model MemberLocation {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  latitude              Float
  longitude             Float
  accuracy              Float?
  timestamp             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, userId])
}

model MailboxLetter {
  id                    String   @id @default(cuid())
  familyId              String
  fromUserId            String
  toUserId              String
  subject               String?
  content               String
  read                  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sender                User     @relation("MailboxLetterSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  recipient             User     @relation("MailboxLetterRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
}

// ============= Wall & Voice Notes =============

model WallEntry {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  message               String
  mediaUrl              String?
  createdAt             DateTime @default(now())

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceNote {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  audioUrl              String
  duration              Int
  transcription         String?
  createdAt             DateTime @default(now())

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============= Assistant Messages =============

model AssistantMessage {
  id                    String   @id @default(cuid())
  familyId              String
  userId                String
  message               String
  role                  String   // "user" or "assistant"
  metadata              Json?
  createdAt             DateTime @default(now())

  // Relations
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
